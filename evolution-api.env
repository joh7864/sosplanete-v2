# Evolution API v2 - Configuration
# Ce fichier est monté dans le conteneur pour écraser les valeurs par défaut internes

SERVER_URL=https://whatsapp.nnauru.net

# Auth
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=EVOE_SECRET_WHATSAPP_KEY_2026

# Database — connecté au PostgreSQL interne (réseau Docker sos_internal)
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://nnauru:me4nnauru@db:5432/evolution
DATABASE_CONNECTION_URI=postgresql://nnauru:me4nnauru@db:5432/evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# Logs
LOG_LEVEL=ERROR
LOG_COLOR=false
DOCKER_ENV=true

# Comportement
DEL_INSTANCE=false
QRCODE_LIMIT=10
