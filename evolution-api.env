# Evolution API v2 - Configuration complète
# Ce fichier remplace le .env interne du conteneur

# Serveur
SERVER_URL=https://whatsapp.nnauru.net
SERVER_PORT=8080
SERVER_TYPE=http
CORS_ORIGIN=*
CORS_METHODS=POST,GET,PUT,DELETE
CORS_CREDENTIALS=true

# Auth
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=evoe4=SecretWhatsappAPI07!

# Logs
LOG_LEVEL=ERROR
LOG_COLOR=false
LOG_BAILEYS=error

# Database PostgreSQL dédiée
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://nnauru:me4nnauru@db:5432/evolution
DATABASE_CONNECTION_URI=postgresql://nnauru:me4nnauru@db:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# Cache — désactivé (pas de Redis)
CACHE_REDIS_ENABLED=false
CACHE_REDIS_URI=redis://localhost:6379
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Stockage fichiers
STORAGE_ENABLED=false

# Manager UI
MANAGER_ENABLED=true
MANAGER_USER=admin
MANAGER_PASSWORD=admin

# Comportement instances
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

# WebHook global — désactivé
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_APPLICATION_STARTUP=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_SET=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=false
WEBHOOK_EVENTS_MESSAGES_UPDATE=false
WEBHOOK_EVENTS_MESSAGES_DELETE=false
WEBHOOK_EVENTS_SEND_MESSAGE=false
WEBHOOK_EVENTS_CONTACTS_SET=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_CONTACTS_UPDATE=false
WEBHOOK_EVENTS_PRESENCE_UPDATE=false
WEBHOOK_EVENTS_CHATS_SET=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CHATS_UPDATE=false
WEBHOOK_EVENTS_CHATS_DELETE=false
WEBHOOK_EVENTS_GROUPS_UPSERT=false
WEBHOOK_EVENTS_GROUPS_UPDATE=false
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=false
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_CALL=false
WEBHOOK_EVENTS_LABELS_EDIT=false
WEBHOOK_EVENTS_LABELS_ASSOCIATION=false
WEBHOOK_EVENTS_REMOVE_INSTANCE=false
WEBHOOK_EVENTS_LOGOUT_INSTANCE=false

# Intégrations — toutes désactivées
TYPEBOT_ENABLED=false
OPENAI_ENABLED=false
CHATWOOT_ENABLED=false
PUSHER_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
