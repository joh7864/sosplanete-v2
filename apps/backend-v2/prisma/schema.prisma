generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique
  password             String
  name                 String?
  avatar               String?
  lastSeenAt           DateTime?      @updatedAt
  role                 Role           @default(AM)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  managedInstances     Instance[]
  managedInstanceYears InstanceYear[]
}

model ActionRef {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  referenceName String
  defaultCo2    Float?
  defaultWater  Float?
  defaultWaste  Float?
  co2Year       Float?
  impactLabel   String?
  impactTotal   Float?
  weightedStars Int?
  image         String?
  description   String?
  year          Int           @default(2025)
  defaultEnergy Float?
  category      String?
  categoryRefId Int?
  categoryRef   CategoryRef?  @relation(fields: [categoryRefId], references: [id])
  localActions  LocalAction[]
}

model Category {
  id             Int           @id @default(autoincrement())
  name           String
  icon           String?
  order          Int           @default(0)
  instanceYearId Int
  instanceYear   InstanceYear  @relation(fields: [instanceYearId], references: [id])
  localActions   LocalAction[]
}

model AnnualImpactData {
  id                        Int     @id @default(autoincrement())
  year                      Int     @unique
  dActuel                   Int?
  moyCo2Monde               Float?
  moyEauMonde               Float?
  moyDechetsMonde           Float?
  popMonde                  Float?
  isCustomized              Boolean @default(false)
  assiduityWeight           Float   @default(0.0)
  annualMultiplierWeight    Float   @default(1.0)
  difficultyFactor          Float   @default(2.0)
  worldProjectionMultiplier Float   @default(1.0)
}

model CategoryRef {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  icon       String?
  order      Int         @default(0)
  actionRefs ActionRef[]
}

model Instance {
  id                Int                        @id @default(autoincrement())
  schoolName        String
  createdAt         DateTime                   @default(now())
  adminId           Int?
  admin             User?                      @relation(fields: [adminId], references: [id])
  instanceYears     InstanceYear[]
  gameConfigs       GameConfig[]
  animalUnlocks     InstanceAnimalUnlock[]
  localActions      LocalAction[]
  terreThermometers TerreThermometerSnapshot[]
}

model InstanceYear {
  id               Int        @id @default(autoincrement())
  instanceId       Int
  schoolYear       String
  hostUrl          String?
  icon             String?
  isOpen           Boolean    @default(false)
  allowAllDelegate Boolean    @default(false)
  gameStartDate    DateTime?
  gameEndDate      DateTime?
  gamePeriodsCount Int        @default(24)
  unlockedChapters Int        @default(0)
  createdAt        DateTime   @default(now())
  adminId          Int?
  admin            User?      @relation(fields: [adminId], references: [id])
  instance         Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  periods          Period[]
  teams            Team[]
  categories       Category[]

  @@unique([instanceId, schoolYear])
  @@unique([hostUrl, schoolYear])
}

model Team {
  id                 Int                 @id @default(autoincrement())
  name               String
  color              String?
  icon               String?
  instanceYearId     Int
  whatsappGroupId    String?
  whatsappInviteUrl  String?
  groups             Group[]
  instanceYear       InstanceYear        @relation(fields: [instanceYearId], references: [id])
  evoeTechnology     EvoeTeamTechnology?
  challengesSent     EvoeChallenge[]     @relation("ChallengerTeam")
  challengesReceived EvoeChallenge[]     @relation("TargetTeam")
}

model Group {
  id       Int     @id @default(autoincrement())
  name     String
  teamId   Int
  color    String?
  children Child[]
  team     Team    @relation(fields: [teamId], references: [id])
}

model Child {
  id          Int          @id @default(autoincrement())
  pseudo      String
  password    String?
  groupId     Int
  avatar      String?
  isDelegate  Boolean      @default(false)
  gender      String?
  birthDate   DateTime?
  actionsDone ActionDone[]
  group       Group        @relation(fields: [groupId], references: [id])

  @@unique([pseudo, groupId])
}

model LocalAction {
  id             Int                     @id @default(autoincrement())
  label          String
  description    String?
  actionRefId    Int
  instanceId     Int
  specificCo2    Float?
  specificWater  Float?
  specificWaste  Float?
  image          String?
  categoryId     Int?
  specificEnergy Float?
  schoolYear     String?
  actionsDone    ActionDone[]
  evoeMission    EvoeMissionTranslation?
  actionRef      ActionRef               @relation(fields: [actionRefId], references: [id])
  category       Category?               @relation(fields: [categoryId], references: [id])
  instance       Instance                @relation(fields: [instanceId], references: [id])
  evoeChallenges EvoeChallenge[]

  @@unique([instanceId, actionRefId, schoolYear])
}

model Period {
  id             Int             @id @default(autoincrement())
  startDate      DateTime
  endDate        DateTime
  instanceYearId Int
  isOpen         Boolean         @default(false)
  actionsDone    ActionDone[]
  instanceYear   InstanceYear    @relation(fields: [instanceYearId], references: [id])
  evoeChallenges EvoeChallenge[]
}

model ActionDone {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  childId       Int
  localActionId Int
  periodId      Int
  savedCo2      Float
  savedWater    Float
  savedWaste    Float
  savedEnergy   Float?
  child         Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  localAction   LocalAction @relation(fields: [localActionId], references: [id])
  period        Period      @relation(fields: [periodId], references: [id])

  @@index([childId, periodId])
  @@index([localActionId])
}

model AnimalRelease {
  id          Int     @id @default(autoincrement())
  name        String
  unlockOrder Int     @unique
  imageUrl    String?
}

model GameConfig {
  id                          Int       @id @default(autoincrement())
  instanceId                  Int
  avgActionsPerChildPerPeriod Int       @default(8)
  animalAdvanceMargin         Int       @default(2)
  bienveillanceThreshold      Float     @default(0.40)
  schoolYear                  String    @default("2024-2025")
  gameStartDate               DateTime?
  gameEndDate                 DateTime?
  gamePeriodsCount            Int       @default(24)
  instance                    Instance  @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, schoolYear])
}

model SystemConfig {
  id                     Int     @id @default(autoincrement())
  emissionsParHabitantAn Float   @default(11.0)
  temperatureMalade      Float   @default(42.0)
  temperatureSaine       Float   @default(37.0)
  populationReference    Int     @default(68000000)
  schoolYear             String  @unique @default("2024-2025")
  youtubeBriefingUrl     String?
  whatsappCommunityName  String?
  whatsappCommunityUrl   String?
  whatsappGeneralUrl     String?
  whatsappGeneralId      String?
}

model InstanceAnimalUnlock {
  id           Int      @id @default(autoincrement())
  instanceId   Int
  period       Int
  periodDate   DateTime
  animalsCount Int
  createdAt    DateTime @default(now())
  schoolYear   String   @default("2024-2025")
  instance     Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, period, schoolYear])
}

model EcoBarRaceSnapshot {
  id         Int      @id @default(autoincrement())
  period     Int
  periodDate DateTime
  rankings   Json
  createdAt  DateTime @default(now())
  schoolYear String   @default("2024-2025")

  @@unique([period, schoolYear])
}

model TerreThermometerSnapshot {
  id                Int      @id @default(autoincrement())
  instanceId        Int
  period            Int
  periodDate        DateTime
  temperatureValue  Float
  totalCo2Saved     Float
  nbChildrenPlaying Int
  createdAt         DateTime @default(now())
  schoolYear        String   @default("2024-2025")
  instance          Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, period, schoolYear])
}

enum Role {
  AS
  AM
}

model Notification {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  title       String
  content     String
  status      String   @default("PENDING")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EvoeMissionTranslation {
  id            Int         @id @default(autoincrement())
  localActionId Int         @unique
  titreSF       String
  descriptionSF String
  pointsGagnes  Int
  isHacked      Boolean     @default(false)
  localAction   LocalAction @relation(fields: [localActionId], references: [id], onDelete: Cascade)

  @@map("evoe_mission_translation")
}

model EvoeTeamTechnology {
  id        Int      @id @default(autoincrement())
  teamId    Int      @unique
  maxLevel  Int      @default(1)
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("evoe_team_technology")
}

model EvoeChallenge {
  id               Int             @id @default(autoincrement())
  challengerTeamId Int
  targetTeamId     Int
  localActionId    Int
  periodId         Int
  status           ChallengeStatus @default(PENDING)
  pledge           String?
  durationHours    Int?
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())

  challengerTeam Team        @relation("ChallengerTeam", fields: [challengerTeamId], references: [id], onDelete: Cascade)
  targetTeam     Team        @relation("TargetTeam", fields: [targetTeamId], references: [id], onDelete: Cascade)
  localAction    LocalAction @relation(fields: [localActionId], references: [id], onDelete: Cascade)
  period         Period      @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("evoe_challenge")
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  SUCCESS
  FAILED
}
