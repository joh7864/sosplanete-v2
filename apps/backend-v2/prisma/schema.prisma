// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 🌍 GLOBAL / COMMON DATA (Géré par l'AS)
// ---------------------------------------------------------

enum Role {
  AS
  AM
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  name       String?
  avatar     String?
  lastSeenAt DateTime? @updatedAt
  role       Role      @default(AM)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Un utilisateur (AM) gère une ou plusieurs instances (généralement une seule école)
  managedInstances Instance[]
}

model ActionRef {
  id            Int     @id @default(autoincrement())
  code          String  @unique // Identifiant métier (ex: W01, E01)
  referenceName String
  defaultCo2    Float? // Valeur par défaut si non surchargée
  defaultWater  Float?
  defaultWaste  Float?
  defaultEnergy Float? // NOUVEAU: kWh économisés
  co2Year       Float? // CO2e /an du fichier CSV
  impactLabel   String? // Impact (Low, Medium, High)
  impactTotal   Float? // Impact total
  weightedStars Int? // Etoile pondérée (1-5)
  image         String? // Nom du fichier image (ex: B01.png)
  year          Int     @default(2025)

  // Liaisons avec les actions personnalisées des instances
  localActions LocalAction[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String
  icon         String?
  order        Int           @default(0)
  instanceId   Int
  schoolYear   String?       // Année scolaire (ex: "2024-2025")
  instance     Instance      @relation(fields: [instanceId], references: [id])
  localActions LocalAction[]
}

model AnnualImpactData {
  id              Int    @id @default(autoincrement())
  year            Int    @unique
  dActuel         Int? // Jour du dépassement mondial (ex: 214)
  moyCo2Monde     Float? // Empreinte CO2 par habitant en tCO2e/an
  moyEauMonde     Float? // Empreinte Eau par habitant en L/an ou m3/an
  moyDechetsMonde Float? // Empreinte Déchets en kg/an
  popMonde        Float? // Population mondiale (ex: 8.1 pour 8.1 milliards)
}

// ---------------------------------------------------------
// 🏫 INSTANCE DATA (Données spécifiques à chaque école)
// ---------------------------------------------------------

model Instance {
  id         Int      @id @default(autoincrement())
  schoolName String
  hostUrl    String?  @unique
  isOpen     Boolean  @default(false)
  icon       String?
  createdAt  DateTime @default(now())

  unlockedChapters  Int       @default(0)
  currentSchoolYear String    @default("2024-2025") // Année scolaire active (ex: "2024-2025")

  // Stimulation v2
  animalUnlocks     InstanceAnimalUnlock[]
  terreThermometers TerreThermometerSnapshot[]
  gameConfigs       GameConfig[]

  // Admin local associé
  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id])

  // Structure de l'école
  teams        Team[]
  localActions LocalAction[]
  periods      Period[]
  categories   Category[]
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  color      String? // Code Hexa ou nom de couleur pastel
  icon       String? // Identifiant d'icône (Lucide ou SVG)
  instanceId Int
  schoolYear String?  // Année scolaire
  instance   Instance @relation(fields: [instanceId], references: [id])

  groups Group[]
}

model Group {
  id     Int     @id @default(autoincrement())
  name   String
  color  String?
  teamId Int
  team   Team    @relation(fields: [teamId], references: [id])

  children Child[]
}

model Child {
  id       Int     @id @default(autoincrement())
  pseudo   String
  password String? // Optionnel si connexion anonyme/pseudo simple
  groupId  Int
  group    Group   @relation(fields: [groupId], references: [id])
  avatar   String?

  actionsDone ActionDone[]

  @@unique([pseudo, groupId]) // Pseudo unique par classe
}

model LocalAction {
  id          Int       @id @default(autoincrement())
  label       String
  description String?
  image       String?
  categoryId  Int? // Remplacement du champ texte
  category    Category? @relation(fields: [categoryId], references: [id])

  // Lien vers le référentiel global
  actionRefId Int
  actionRef   ActionRef @relation(fields: [actionRefId], references: [id])

  // Appartenance à l'instance
  instanceId Int
  schoolYear String?  // Année scolaire
  instance   Instance @relation(fields: [instanceId], references: [id])

  // Surcharges éventuelles des poids d'impact par instance
  specificCo2    Float?
  specificWater  Float?
  specificWaste  Float?
  specificEnergy Float?

  actionsDone ActionDone[]

  @@unique([instanceId, actionRefId, schoolYear])
}

model Period {
  id         Int      @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  isOpen     Boolean  @default(false)
  instanceId Int
  schoolYear String?  // Rattachement à une année scolaire (ex: "2024-2025")
  instance   Instance @relation(fields: [instanceId], references: [id])

  actionsDone ActionDone[]
}

model ActionDone {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  childId Int
  child   Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  localActionId Int
  localAction   LocalAction @relation(fields: [localActionId], references: [id])

  periodId Int
  period   Period @relation(fields: [periodId], references: [id])

  // Valeurs calculées au moment de l'enregistrement pour historique stable
  savedCo2    Float
  savedWater  Float
  savedWaste  Float
  savedEnergy Float?
}

// ---------------------------------------------------------
// 🦊 GAMIFICATION (Moteur d'animaux)
// ---------------------------------------------------------

model AnimalRelease {
  id          Int     @id @default(autoincrement())
  name        String
  unlockOrder Int     @unique // 1 à 9
  imageUrl    String?
}

// ---------------------------------------------------------
// 🚀 SYSTEME DE STIMULATION (V2)
// ---------------------------------------------------------

// Paramètres de l'instance
model GameConfig {
  id                          Int      @id @default(autoincrement())
  instanceId                  Int
  schoolYear                  String   @default("2024-2025")
  avgActionsPerChildPerPeriod Int      @default(8)
  animalAdvanceMargin         Int      @default(2)
  bienveillanceThreshold      Float    @default(0.40)
  
  // Paramètres du jeu (isolés par année)
  gameStartDate    DateTime?
  gameEndDate      DateTime?
  gamePeriodsCount Int       @default(24)

  instance Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, schoolYear])
}

// Paramètres Mondiaux
model SystemConfig {
  id                     Int      @id @default(autoincrement())
  schoolYear             String   @default("2024-2025")
  emissionsParHabitantAn Float    @default(11.0)
  temperatureMalade      Float    @default(42.0)
  temperatureSaine       Float    @default(37.0)
  populationReference    Int      @default(68000000)

  @@unique([schoolYear])
}

model InstanceAnimalUnlock {
  id           Int      @id @default(autoincrement())
  instanceId   Int
  period       Int
  periodDate   DateTime
  animalsCount Int
  schoolYear   String   @default("2024-2025")
  createdAt    DateTime @default(now())
  instance     Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, period, schoolYear])
}

model EcoBarRaceSnapshot {
  id         Int      @id @default(autoincrement())
  period     Int
  periodDate DateTime
  rankings   Json
  schoolYear String   @default("2024-2025")
  createdAt  DateTime @default(now())

  @@unique([period, schoolYear])
}

model TerreThermometerSnapshot {
  id                Int      @id @default(autoincrement())
  instanceId        Int
  period            Int
  periodDate        DateTime
  temperatureValue  Float
  totalCo2Saved     Float
  nbChildrenPlaying Int
  schoolYear        String   @default("2024-2025")
  createdAt         DateTime @default(now())
  instance          Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, period, schoolYear])
}
